# ── Server ──────────────────────────────────────────────
SERVER_HOST=localhost
SERVER_PORT=3000
NODE_ENV=development

# ── Logger ──────────────────────────────────────────────
LOG_DIR=./logs
LOG_REQUEST_BODY=true
LOG_RESPONSE_BODY=true

# Note: the AI model endpoint / API key / model name and sender profile are
# configured at runtime in the in-app Settings page (persisted in the database),
# not through environment variables.
